{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.dev/schemas/benchmark/suite-0.1.schema.json",
  "title": "Chronicle benchmark suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "dataset_version",
    "description",
    "profile",
    "default_k",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "suite_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "profile": {"enum": ["contract", "provider-retrieval", "chronicle-gateway"]},
    "default_k": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "security_gate", "required_capabilities", "operations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "security_gate": {"type": "boolean"},
        "required": {"type": "boolean", "default": true},
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"enum": ["retain", "recall", "supersede", "delete", "authorize", "promote", "fail_next"]},
        "record": {"type": "object"},
        "query": {"type": "object"},
        "expected": {"type": "object"},
        "expect": {"enum": ["accepted", "rejected", "allow", "deny", "denied"]},
        "expected_error": {"type": "boolean"},
        "id": {"type": "string"},
        "old_id": {"type": "string"},
        "new_id": {"type": "string"},
        "at": {"type": "string", "format": "date-time"},
        "action": {"enum": ["read", "write"]},
        "scope": {"type": "string"},
        "principal": {"type": "object"},
        "actor": {"type": "object"},
        "verifier": {"type": "object"}
      }
    }
  }
}
